# Frontend environment variables for EduInnovate LMS (React)

# Supabase configuration (MANDATORY for real auth)
# Use your Supabase Project URL and anon public key
REACT_APP_SUPABASE_URL=https://your-supabase-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# Site URL used for email confirmation redirect after signup
# During local dev this should match your running frontend origin
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional environment values used elsewhere in the app
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS={"showWelcome":true}
REACT_APP_EXPERIMENTS_ENABLED=false
