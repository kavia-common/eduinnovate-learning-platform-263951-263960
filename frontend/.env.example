# Frontend environment example for EduInnovate LMS

# App URLs
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=

# Supabase (auth, data, and optional Edge Functions)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# AI Provider selection:
# Preferred: Supabase Edge Functions (auto-selected when SUPABASE_URL is set)
# Alternative: OpenAI-compatible provider
REACT_APP_AI_PROVIDER=openai
REACT_APP_OPENAI_API_BASE=https://api.openai.com/v1
REACT_APP_OPENAI_API_KEY=sk-REPLACE_ME

# Notes:
# - Do not commit real keys. Use environment injection in deployment.
# - If no provider is configured, the UI falls back to safe mock responses with toasts.
