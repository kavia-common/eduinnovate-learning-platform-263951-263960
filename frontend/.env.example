# PUBLIC_INTERFACE
# Example environment variables for EduInnovate LMS Frontend
# Copy to .env and adjust as necessary. Do NOT commit secrets.

# Prefer this for REST API base. If empty/unset, client will fall back to mock data.
REACT_APP_API_BASE=

# Optional alternative backend base (used if REACT_APP_API_BASE is empty).
# Typically the same as API base for legacy setups.
REACT_APP_BACKEND_URL=

# Frontend site URL used for Supabase emailRedirectTo and other redirects.
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket URL if real-time features are enabled (optional)
REACT_APP_WS_URL=

# Node/React environment flags (optional)
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (JSON object/array or comma-separated list)
# Examples:
# REACT_APP_FEATURE_FLAGS={"showWelcome":true}
# REACT_APP_FEATURE_FLAGS=showWelcome,newUI
REACT_APP_FEATURE_FLAGS=

# Experiments toggle (optional)
REACT_APP_EXPERIMENTS_ENABLED=false

# Supabase (optional). If missing, app falls back to mock/local auth.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
